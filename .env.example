# Copie para .env.local (no seu computador) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# --- Site (públicas: podem aparecer no navegador) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Google Maps no navegador (mapa e busca de cidades). Restrinja a chave ao domínio do site.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID criado em Google Cloud → Google Maps Platform → Map Management
VITE_GOOGLE_MAPS_MAP_ID=
# true só para testar sem login. Nunca em produção.
VITE_DEMO_MODE=false

# --- Servidor (SECRETAS: nunca coloque no código nem com prefixo VITE_) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Cakto → Integrações → Webhooks: a chave secreta mostrada ao criar o webhook
CAKTO_WEBHOOK_SECRET=
# Google Places no servidor (busca de comércios). Chave SEPARADA, restrita à Places API (New).
GOOGLE_PLACES_API_KEY=
# Códigos dos links de checkout (o final de pay.cakto.com.br/CODIGO). Aceita vários, separados por vírgula.
CAKTO_LIFETIME_IDS=ubgv3n5
CAKTO_MONTHLY_IDS=pehqx45
